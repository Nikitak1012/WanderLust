# Server Configuration
PORT=8080
NODE_ENV=development

# Database Connection (MongoDB Atlas Connection URI)
ATLASDB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/wanderlust?retryWrites=true&w=majority

# Session Security Secret
SECRET=your_super_secret_session_key_here

# Cloudinary Cloud Storage Credentials (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
